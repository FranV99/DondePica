{
  "name": "dondepica",
  "private": true,
  "version": "4.0.0",
  "description": "DóndePica: el mapa abierto de la pesca en agua dulce en España",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint src scripts",
    "preview": "vite preview",
    "geo:osm": "node scripts/geometria-osm.mjs",
    "datos": "node --max-old-space-size=6144 scripts/descargar-masas.mjs",
    "datos:arroyos": "node --max-old-space-size=8192 scripts/descargar-masas.mjs --arroyos",
    "datos:construir": "node --max-old-space-size=8192 scripts/descargar-masas.mjs --solo-construir",
    "cebos": "node scripts/descargar-cebos.mjs"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-leaflet": "^5.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.90.0",
    "vite": "^8.3.6"
  }
